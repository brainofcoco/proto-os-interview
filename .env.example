# OpenRouter API Configuration
# Copy this file to .env and fill in your actual values

# Required: Your OpenRouter API key
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: Custom base URL (defaults to https://openrouter.ai/api/v1)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional: Site information for OpenRouter rankings
# These headers help your app appear on OpenRouter leaderboards
OPENROUTER_SITE_URL=https://yourapp.com
OPENROUTER_SITE_NAME=Your App Name

# Example values:
# OPENROUTER_API_KEY=sk-or-v1-1234567890abcdef...
# OPENROUTER_SITE_URL=https://myapp.com
# OPENROUTER_SITE_NAME=My AI Application
