# =============================================================================
# Multi-Provider LLM Configuration
# =============================================================================

# Default provider to use (openrouter, openai, anthropic)
DEFAULT_LLM_PROVIDER=openrouter

# Global settings for all providers
LLM_TIMEOUT=30
LLM_MAX_RETRIES=3
LLM_RETRY_DELAY=1.0

# =============================================================================
# OpenRouter Configuration
# =============================================================================
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: OpenRouter Base URL (default: https://openrouter.ai/api/v1)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional: Site information for OpenRouter rankings
# OPENROUTER_SITE_URL=https://your-site.com
# OPENROUTER_SITE_NAME=Your Site Name

# =============================================================================
# OpenAI Configuration
# =============================================================================
# Get your API key from: https://platform.openai.com/api-keys
# OPENAI_API_KEY=your_openai_api_key_here

# Optional: OpenAI Base URL (default: https://api.openai.com/v1)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: OpenAI Organization ID
# OPENAI_ORGANIZATION=your_organization_id

# =============================================================================
# Anthropic/Claude Configuration
# =============================================================================
# Get your API key from: https://console.anthropic.com/
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: Anthropic Base URL (default: https://api.anthropic.com)
# ANTHROPIC_BASE_URL=https://api.anthropic.com
